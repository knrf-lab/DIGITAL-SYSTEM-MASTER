set_property IOSTANDARD LVCMOS33 [get_ports CLK100MHZ]
set_property IOSTANDARD LVCMOS33 [get_ports Rst]
set_property IOSTANDARD LVCMOS33 [get_ports clk_led]
set_property IOSTANDARD LVCMOS33 [get_ports {output[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {output[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {output[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {output[0]}]
set_property PACKAGE_PIN E3 [get_ports CLK100MHZ]
set_property PACKAGE_PIN V10 [get_ports Rst]
set_property PACKAGE_PIN V11 [get_ports clk_led]
set_property PACKAGE_PIN N14 [get_ports {output[3]}]
set_property PACKAGE_PIN J13 [get_ports {output[2]}]
set_property PACKAGE_PIN K15 [get_ports {output[1]}]
set_property PACKAGE_PIN H17 [get_ports {output[0]}]
create_clock -period 10.000 -name sys_clk [get_ports CLK100MHZ]
